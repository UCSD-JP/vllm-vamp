#!/usr/bin/env python3
"""2-worker Dynamo KV-routing smoke (CXL 미사용).

목적: (1) 두 worker에 요청이 실제로 분산되는지, (2) KV router가 prefix locality를
      반영해 같은 prefix를 같은 worker로 보내는지 관찰.
판정은 worker별 sidecar(wstats_*.jsonl)의 prefix hit/queries 델타 합으로 한다.
"""
import argparse, json, time, urllib.request
from concurrent.futures import ThreadPoolExecutor

P = argparse.ArgumentParser()
P.add_argument("--url", default="http://localhost:8080/v1/chat/completions")
P.add_argument("--model", default="Qwen/Qwen3-14B")
P.add_argument("--sessions", type=int, default=4, help="구분되는 prefix 개수")
P.add_argument("--turns", type=int, default=3, help="세션당 연속 turn 수 (prefix 재사용)")
P.add_argument("--prefix-tokens", type=int, default=1500)
P.add_argument("--out", default="/tmp/routing_smoke.jsonl")
args = P.parse_args()

# 세션별로 고유하고 충분히 긴 prefix (block 단위 재사용을 유발)
def make_prefix(sid):
    head = f"[SESSION-{sid}] You are reviewing repository #{sid}. Reference notes follow.\n"
    body = " ".join(f"s{sid}-note{i}-{(i*7919+sid) % 10007}" for i in range(args.prefix_tokens))
    return head + body

def call(sid, turn, prefix):
    msg = prefix + f"\n\nTurn {turn}: reply with exactly SESSION{sid}_TURN{turn}_OK /no_think"
    body = json.dumps({"model": args.model,
                       "messages": [{"role": "user", "content": msg}],
                       "max_tokens": 32, "temperature": 0}).encode()
    req = urllib.request.Request(args.url, data=body, headers={"Content-Type": "application/json"})
    t0 = time.time()
    try:
        d = json.load(urllib.request.urlopen(req, timeout=300))
        dt = time.time() - t0
        return {"session": sid, "turn": turn, "latency_s": round(dt, 3),
                "ok": True, "usage": d.get("usage"),
                "content": (d["choices"][0]["message"].get("content") or "").strip()[:40]}
    except Exception as e:
        return {"session": sid, "turn": turn, "latency_s": round(time.time()-t0, 3),
                "ok": False, "error": f"{type(e).__name__}: {e}"}

prefixes = {s: make_prefix(s) for s in range(args.sessions)}
rows = []

# turn 단위로 라운드 진행: 각 라운드에서 모든 세션이 동시에 요청 → 분산 관찰
for turn in range(args.turns):
    with ThreadPoolExecutor(max_workers=args.sessions) as ex:
        futs = [ex.submit(call, s, turn, prefixes[s]) for s in range(args.sessions)]
        for f in futs:
            r = f.result(); rows.append(r)
            print(json.dumps(r, ensure_ascii=False), flush=True)
    time.sleep(1)

with open(args.out, "w") as f:
    for r in rows:
        f.write(json.dumps(r, ensure_ascii=False) + "\n")

ok = sum(1 for r in rows if r["ok"])
lat = sorted(r["latency_s"] for r in rows if r["ok"])
print(f"\n=== SUMMARY: {ok}/{len(rows)} ok"
      + (f" | latency median {lat[len(lat)//2]:.2f}s max {lat[-1]:.2f}s" if lat else "")
      + f" | out={args.out}")
