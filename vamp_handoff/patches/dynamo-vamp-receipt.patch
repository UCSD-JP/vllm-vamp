+    def _vamp_wrong_worker(self, request):
+        """VAMP exact targeting: a request that names a target worker must
+        not run elsewhere (spec: wrong-worker execution is an immediate stop).
+        Returns the target id when this worker is not it, else None."""
+        target = request.get("vamp_target_worker") if isinstance(request, dict) else None
+        if target and self.vamp_worker_id and target != self.vamp_worker_id:
+            return target
+        return None
